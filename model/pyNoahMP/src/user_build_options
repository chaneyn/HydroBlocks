#=============================================================================================
#  Options for macOS ARM64 with conda-forge gfortran
#=============================================================================================

COMPILERF90    =       /opt/anaconda3/envs/hb/bin/gfortran

FREESOURCE     =       -ffree-form -ffree-line-length-none

F90FLAGS       =       -g -fconvert=big-endian -fbounds-check -fno-range-check -fPIC

MODFLAG        =       -I

LDFLAGS        =

CPP            =       /opt/anaconda3/envs/hb/bin/cpp
CPPFLAGS       =       -x c -P -traditional -D_GFORTRAN_

LIBS           =

LIBJASPER      =
INCJASPER      =

NETCDFMOD      =       -I/opt/anaconda3/envs/hb/include
NETCDFLIB      =       -L/opt/anaconda3/envs/hb/lib -lnetcdff -lnetcdf

BZIP2          =       NO
BZIP2_LIB      =
BZIP2_INCLUDE  =

RM             =       rm -f

CC             =       /opt/anaconda3/envs/hb/bin/gcc